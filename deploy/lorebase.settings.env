# Demo settings for the Lorebase compose file (no secrets: those live in the generated,
# git-ignored deploy/lorebase.env, which is read after this file and wins, except for the pin below).
#
# Lorebase release the demo runs (scripts/lorebase-up.sh): images
# $LOREBASE_REGISTRY/lorebase{,-ml,-web}:$LOREBASE_VERSION, pulled when missing, with the compose
# file and the configuration of the same release, copied verbatim into deploy/compose/ and
# deploy/lorebase.yaml: a new release means a new version and fresh copies of those files.
# LOREBASE_FROM_SOURCE=1 builds the images from a Lorebase checkout instead (LOREBASE_REPO).
LOREBASE_VERSION=0.3.1
LOREBASE_REGISTRY=ghcr.io/aantenore
LOREBASE_PULL_POLICY=missing
LOREBASE_COMPOSE_FILE=deploy/compose/docker-compose.yaml
LOREBASE_CONFIG_FILE=deploy/lorebase.yaml
LOREBASE_FROM_SOURCE=0
#
# Self approval: the demo runs with auth mode none (one anonymous principal), so the author of a
# rule-change Proposal must be allowed to approve it.
LOREBASE__KEEPER__PROPOSALS__ALLOW_SELF_APPROVAL=true
# The `set_rule` Operation has review policy `never`, so it commits straight to the protected
# `main` branch; every other change needs a Proposal.
LOREBASE__KEEPER__OPERATIONS__DIRECT_COMMIT_ON_PROTECTED=true
# Browser access for the Lorebase web app in live mode (cross origin, no cookies); ETag and
# If-None-Match are handled by Keeper's defaults.
LOREBASE__KEEPER__CORS__ALLOW_ORIGINS='["http://localhost:5180","http://127.0.0.1:5180"]'

# Herald (profile mcp): the agents' read access to the world, http://127.0.0.1:8190/mcp.
HERALD_HOST_PORT=8190
# Keeper runs with auth mode none: calls without a bearer are forwarded as they are.
HERALD_ALLOW_ANONYMOUS=true
HERALD_DOMAIN=world
HERALD_BRANCH=main
