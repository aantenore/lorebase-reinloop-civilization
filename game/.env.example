# Backend target for the dev proxy (/ws and /api -> target)
GAME_PROXY_TARGET=http://localhost:4400
GAME_PORT=5174
# Client-side paths/bases (default: same origin through the proxy)
VITE_WS_URL=
VITE_WS_PATH=/ws
VITE_API_BASE=/api
# Fall back to the in-browser mock world when the socket cannot connect (1/0)
VITE_MOCK_FALLBACK=1
# Optional shared token when the server sets SIM_API_TOKEN (or pass ?token= in the URL)
VITE_SIM_TOKEN=
# Lorebase web UI, linked from god mode ("Apri in Lorebase")
VITE_LOREBASE_UI_URL=http://localhost:5180
# Review list of the Domain in the Lorebase UI; each law proposal opens at <path>/<proposal id>
VITE_LOREBASE_REVIEW_PATH=/world/review
